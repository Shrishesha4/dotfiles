# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=($HOME/.docker/completions $fpath)
# End of Docker CLI completions

# Homebrew zsh completions
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH
fi

autoload -Uz compinit
compinit

export PATH="$HOME/.local/bin:$PATH"

export EDITOR="cursor --wait"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

alias term="zellij --layout backend"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi

command -v brew >/dev/null 2>&1 && alias bubu="brew update && brew upgrade -y"

alias npmrd="npm run dev"
alias npmrb="npm run build"
alias npmrp="npm run preview"

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Better commands
command -v eza >/dev/null 2>&1 && alias ls='eza --icons' || alias ls='ls --color=auto'
command -v eza >/dev/null 2>&1 && alias ll='eza -lah --icons'
command -v eza >/dev/null 2>&1 && alias la='eza -a --icons'
command -v eza >/dev/null 2>&1 && alias tree='eza --tree --icons'
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never --style=plain'
command -v rg >/dev/null 2>&1 && alias grep='rg'

# Git
command -v git >/dev/null 2>&1 && alias gs='git status'
command -v git >/dev/null 2>&1 && alias ga='git add'
command -v git >/dev/null 2>&1 && alias gc='git commit'
command -v git >/dev/null 2>&1 && alias gp='git push'
command -v git >/dev/null 2>&1 && alias gl='git pull'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'

# Docker
alias d='docker'
alias dc='docker compose'
alias dps='docker ps'
alias di='docker images'

# Python
alias py='python'
alias v='source .venv/bin/activate'

#zsh
alias rz="source ~/.zshrc"

command -v duf >/dev/null 2>&1 && alias df="duf"

# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# Java 21 (Homebrew)
if [ -d /opt/homebrew/opt/openjdk@21/bin ]; then
  export PATH="/opt/homebrew/opt/openjdk@21/bin:$PATH"
  export JAVA_HOME="/opt/homebrew/opt/openjdk@21"
fi

# Added by Antigravity IDE
export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# zsh autosuggestions + syntax highlighting (must be near end of .zshrc)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null || true
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null || true
export ZSH_HIGHLIGHT_HIGHLIGHTERS_DIR=/opt/homebrew/share/zsh-syntax-highlighting/highlighters

# Machine-local overrides / secrets (see ~/.zshrc.local, gitignored)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
